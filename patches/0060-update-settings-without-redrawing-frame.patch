+static void DrawGameSettingsHelp(word x, byte selection, bbool save_failed)
+{
+    char *help = selection <= SETTING_GAMEPAD
+        ? TOUCH_MENU_TEXT("Enter or A opens, Esc or B back", "Tap Select to open or Back")
+        : TOUCH_MENU_TEXT("Left and Right   Esc or B back", "Left/Right to change. Back");
+    if (save_failed) help = "Could not save setting";
+    word y = SETTINGS_TOP + SETTINGS_HEIGHT - 2;
+    ClearSettingsText(x, y, SETTINGS_WIDTH - 2);
+    DrawTextLine(20 - strlen(help) / 2, y, help);
+}
+
+static void DrawGameSettings(word x, byte selection)
+{
+#ifndef __ANDROID__
+    DrawTextLine(x + 2, settingsRows[SETTING_KEYBOARD], "Keyboard Mapping");
+#endif
+    DrawTextLine(x + 2, settingsRows[SETTING_GAMEPAD], "Gamepad Controls");
+    DrawTextLine(x + 2, settingsRows[SETTING_MUSIC], "Music Volume");
+    DrawTextLine(x + 2, settingsRows[SETTING_SOUND], "Sound Volume");
+    DrawTextLine(x + 2, settingsRows[SETTING_FILTER], "Filter");
+#ifdef COSMO_TOUCH_PREVIEW
+    DrawTextLine(x + 2, settingsRows[SETTING_TOUCH], "Touch Controls");
+#endif
+    for (byte setting = SETTING_MUSIC; setting < SETTING_COUNT; setting++)
+        DrawGameSettingsValue(x, setting);
+    DrawTextLine(x, settingsRows[selection], ">");
+    DrawGameSettingsHelp(x, selection, false);
 }
 
